{
    "name": "danmyers/akeneo-custom-entity-bundle",
    "type": "symfony-bundle",
    "description": "Custom entities (reference data) for Akeneo PIM 7: CRUD screens, datagrids, CSV import/export, mass actions, history and product attribute integration from a single config entry.",
    "keywords": ["akeneo", "pim", "reference data", "custom entity", "symfony-bundle"],
    "homepage": "https://github.com/danmyers/akeneo-custom-entity-bundle",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Daniel Myers"
        }
    ],
    "require": {
        "php": "^8.1",
        "akeneo/pim-community-dev": "^7.0"
    },
    "suggest": {
        "danmyers/akeneo-reference-data-picker-bundle": "Modal picker to add several reference data (custom entities included) at once on products"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "DanMyers\\CustomEntityBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DanMyers\\CustomEntityBundle\\Tests\\": "tests/",
            "Acme\\Bundle\\CustomEntityDemoBundle\\": "examples/AcmeCustomEntityDemoBundle/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "minimum-stability": "stable"
}
